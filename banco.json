    ],
    [
     "Verbo",
     "Dice una acción: come, camina, buscaron."
    ],
    [
     "Artículo",
     "Va antes del sustantivo: el, la, los, las, un, una, unos, unas."
    ],
    [
     "Pronombre",
     "Reemplaza al nombre: yo, tú/vos, él, ella, nosotros, ustedes, ellos."
    ],
    [
     "Infinitivo",
     "El nombre del verbo, termina en -ar, -er, -ir: caminar, comer, dormir."
    ],
    [
     "Comparación",
     "Compara usando “como”: brilla como una piedra mojada."
    ],
    [
     "Personificación",
     "Una cosa hace algo de personas: el viento le susurra canciones."
    ],
    [
     "Repetición",
